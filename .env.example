PORT=3000
NODE_ENV=development

# URL absolut production website (tanpa trailing slash). Dipakai untuk canonical,
# og:url, sitemap.xml, robots.txt, dan JSON-LD. Kosong saat dev -> fallback localhost:PORT.
# SITE_URL=https://sukamoto.example

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sukamoto

# Origin yang boleh memanggil /api dari domain lain (pisahkan dengan koma).
# Kosongkan jika frontend dilayani dari server yang sama. Production: isi domain SUKA MOTO.
# CORS_ORIGINS=https://sukamoto.example

# Jumlah reverse proxy di depan server (mis. 1 untuk Nginx) agar rate limit membaca IP asli.
# TRUST_PROXY=1
